# Pitz Pulse environment variables (Spec 04 §3 is the single source; this file mirrors it).
# `cp .env.example .env` without a key fails fast naming the variable; with no .env at all the
# stack runs in mock mode. Empty = unset everywhere except LLM_TEMPERATURE.

# Provider: anthropic_api | claude_agent_sdk | mock (D29: set here so a clean clone fails fast
# naming ANTHROPIC_API_KEY below, or switch this to mock to run without any credential)
LLM_PROVIDER=anthropic_api
# Model id from the models catalog; empty uses the code default (claude-haiku-4-5)
LLM_MODEL=
# Sampling temperature 0-1, or "none" to omit it from the call; empty is invalid, unlike every
# other variable here (use 0 or none, never a blank value)
LLM_TEMPERATURE=0
# Prompt version under apps/api/prompts/; must match the active version in code
PROMPT_VERSION=v1
# Per-attempt LLM call timeout in seconds; empty uses the code default (30)
LLM_TIMEOUT_SECONDS=
# Max transport retries per call; empty uses the code default (3)
LLM_MAX_RETRIES=
# Retries after an invalid tool-call output; empty uses the code default (1)
INVALID_OUTPUT_RETRIES=
# Max concurrent model calls (batch and API; also sizes the API worker threads); empty uses the
# code default (4)
LLM_CONCURRENCY=
# Below this confianza a request enters the review queue (needs_review); 0.7 is a placeholder
# until a real run (G35); empty uses the code default (0.7)
CONFIDENCE_THRESHOLD=
# Log level: DEBUG | INFO | WARNING | ERROR; empty uses the code default (INFO)
LOG_LEVEL=
# Anthropic API key; required only when LLM_PROVIDER=anthropic_api. Never commit a real value.
ANTHROPIC_API_KEY=
# Claude Agent SDK OAuth token (`claude setup-token`); required only when
# LLM_PROVIDER=claude_agent_sdk. Never commit a real value.
CLAUDE_CODE_OAUTH_TOKEN=
# API key clients send as X-API-Key; dev-local-key is local only, never use it in production
API_KEY=dev-local-key
# SQLite file path; empty uses the code default (<APP_ROOT>/data/pitz_pulse.db). docker-compose
# fixes this to /data/pitz_pulse.db, so it only matters for local (non-Docker) runs.
DB_PATH=
# Minimum seconds before a pending request is considered stale; empty uses the derived minimum
PENDING_STALE_SECONDS=
# Host port docker compose publishes the API on; empty uses the compose default (8000)
API_PORT=
# Slack request signature secret; for the planned Slack integration, not yet implemented
# (Spec 06d). Empty disables it.
SLACK_SIGNING_SECRET=
# Slack bot token; for the planned Slack integration, not yet implemented (Spec 06d). Empty
# disables it.
SLACK_BOT_TOKEN=
# Duplicate-message similarity threshold; empty uses the code default (0.85, Spec 06c)
DUPLICATE_THRESHOLD=
# Slack channel-to-area mapping; for the planned Slack integration, not yet implemented
# (Spec 06d). Empty disables channel-based routing.
SLACK_CHANNEL_AREAS=
# Docker-only override of the package root; docker-compose fixes this to /app, so it only
# matters for local (non-Docker) runs. Leave empty for local/non-Docker runs.
APP_ROOT=
# LangSmith/LangChain tracing: forced to false in-process regardless of this file. Never set any
# of these to true — tracing would upload request/graph data.
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_TRACING_V2=false
